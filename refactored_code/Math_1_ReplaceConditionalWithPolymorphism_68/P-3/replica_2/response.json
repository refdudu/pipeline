            "text": "{\n  \"refactored_code\": \"/*\\n * Licensed to the Apache Software Foundation (ASF) under one or more\\n * contributor license agreements.  See the NOTICE file distributed with\\n * this work for additional information regarding copyright ownership.\\n * The ASF licenses this file to You under the Apache License, Version 2.0\\n * (the \\\"License\\\"); you may not use this file except in compliance with\\n * the License.  You may obtain a copy of the License at\\n *\\n *      http://www.apache.org/licenses/LICENSE-2.0\\n *\\n * Unless required by applicable law or agreed to in writing, software\\n * distributed under the License is distributed on an \\\"AS IS\\\" BASIS,\\n * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\\n * See the License for the specific language governing permissions and\\n * limitations under the License.\\n */\\npackage org.apache.commons.math3.primes;\\n\\nimport org.apache.commons.math3.exception.MathIllegalArgumentException;\\nimport org.apache.commons.math3.exception.util.LocalizedFormats;\\n\\nimport java.util.List;\\n\\n/**\\n * Methods related to prime numbers in the range of <code>int</code>:\\n * <ul>\\n * <li>primality test</li>\\n * <li>prime number generation</li>\\n * <li>factorization</li>\\n * </ul>\\n *\\n * @version $Id$\\n * @since 3.2\\n */\\npublic class Primes {\\n\\n    /**\\n     * Hide utility class.\\n     */\\n    private Primes() {\\n    }\\n\\n    /**\\n     * Primality test: tells if the argument is a (provable) prime or not.\\n     * <p>\\n     * It uses the Miller-Rabin probabilistic test in such a way that a result is guaranteed:\\n     * it uses the firsts prime numbers as successive base (see Handbook of applied cryptography\\n     * by Menezes, table 4.1).\\n     *\\n     * @param n number to test.\\n     * @return true if n is prime. (All numbers &lt; 2 return false).\\n     */\\n    public static boolean isPrime(int n) {\\n        return IntNumber.of(n).isPrime();\\n    }\\n\\n    /**\\n     * Return the smallest prime greater than or equal to n.\\n     *\\n     * @param n a positive number.\\n     * @return the smallest prime greater than or equal to n.\\n     * @throws MathIllegalArgumentException if n &lt; 0.\\n     */\\n    public static int nextPrime(int n) {\\n        return IntNumber.of(n).nextPrime();\\n    }\\n\\n    /**\\n     * Prime factors decomposition\\n     *\\n     * @param n number to factorize: must be &ge; 2\\n     * @return list of prime factors of n\\n     * @throws MathIllegalArgumentException if n &lt; 2.\\n     */\\n    public static List<Integer> primeFactors(int n) {\\n        return IntNumber.of(n).primeFactors();\\n    }\\n\\n    /**\\n     * Polymorphic representation of an integer for prime operations.\\n     */\\n    private abstract static class IntNumber {\\n        protected final int val;\\n\\n        IntNumber(int val) {\\n            this.val = val;\\n        }\\n\\n        abstract boolean isPrime();\\n\\n        abstract int nextPrime();\\n\\n        abstract List<Integer> primeFactors();\\n\\n        static IntNumber of(int val) {\\n            if (val < 2) {\\n                return new LessThanTwo(val);\\n            } else if (val == 2) {\\n                return new Two();\\n            } else {\\n                return new GreaterThanTwo(val);\\n            }\\n        }\\n    }\\n\\n    private static class LessThanTwo extends IntNumber {\\n        LessThanTwo(int val) {\\n            super(val);\\n        }\\n\\n        @Override\\n        boolean isPrime() {\\n            return false;\\n        }\\n\\n        @Override\\n        int nextPrime() {\\n            if (val < 0) {\\n                throw new MathIllegalArgumentException(LocalizedFormats.NUMBER_TOO_SMALL, val, 0);\\n            }\\n            return 2;\\n        }\\n\\n        @Override\\n        List<Integer> primeFactors() {\\n            throw new MathIllegalArgumentException(LocalizedFormats.NUMBER_TOO_SMALL, val, 2);\\n        }\\n    }\\n\\n    private static class Two extends IntNumber {\\n        Two() {\\n            super(2);\\n        }\\n\\n        @Override\\n        boolean isPrime() {\\n            return true;\\n        }\\n\\n        @Override\\n        int nextPrime() {\\n            return 2;\\n        }\\n\\n        @Override\\n        List<Integer> primeFactors() {\\n            return SmallPrimes.trialDivision(2);\\n        }\\n    }\\n\\n    private static class GreaterThanTwo extends IntNumber {\\n        GreaterThanTwo(int val) {\\n            super(val);\\n        }\\n\\n        @Override\\n        boolean isPrime() {\\n            for (int p : SmallPrimes.PRIMES) {\\n                if (0 == (val % p)) {\\n                    return val == p;\\n                } \\n            }\\n            return SmallPrimes.millerRabinPrimeTest(val);\\n        }\\n\\n        @Override\\n        int nextPrime() {\\n            int n = val | 1;\\n            if (IntNumber.of(n).isPrime()) {\\n                return n;\\n            }\\n            final int rem = n % 3;\\n            if (0 == rem) {\\n                n += 2;\\n            } else if (1 == rem) {\\n                n += 4;\\n            }\\n            while (true) {\\n                if (IntNumber.of(n).isPrime()) {\\n                    return n;\\n                }\\n                n += 2;\\n                if (IntNumber.of(n).isPrime()) {\\n                    return n;\\n                }\\n                n += 4;\\n            }\\n        }\\n\\n        @Override\\n        List<Integer> primeFactors() {\\n            return SmallPrimes.trialDivision(val);\\n        }\\n    }\\n}\"\n}",
